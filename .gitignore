# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/

# 執行期產物（HTTP 快取 / SQLite / log）— 全由管線重建，不入庫
data/*
# …但保留追蹤版本的「持股介紹」快照（data/funds/*.json 為 fetch_holdings.py 產出、儀表板資料源）
!data/funds/
data/funds/*
!data/funds/*.json
# 台股版本持股快照（data/funds_tw/*.json 為 fetch_holdings.py --market tw 產出、tw.html 資料源）
!data/funds_tw/
data/funds_tw/*
!data/funds_tw/*.json
# 基金動態雷達自動新聞快照（fetch_mentions.py 產出、儀表板資料源）
!data/mentions/
data/mentions/*
!data/mentions/*.json
# GitHub PAT（建 repo 用）絕不入庫
.gh_tok
data/.gh_tok

# 每日報告為輸出產物（如需保留歷史可移除此行）；昨夜美股新聞（reports/usnews/*.md）保留入庫
reports/*.md
# 昨夜美股提示包為可重建產物（gen_usnews.py）
reports/usnews/prompts/
# 台股新聞提示包為可重建產物（gen_twnews.py）；{date}_v*.md 新聞內容保留入庫
reports/twnews/prompts/
# 重點觀察數據提示包為可重建產物（gen_indicators.py）；{date}.json 數據保留入庫
reports/indicators/prompts/
# 社群/廣告提及提示包為可重建產物（gen_mentions.py）；{date}.json 保留入庫
reports/mentions/prompts/

# M6 文案層產物（由 gen_copy.py 重建；responses 為手動回灌內容，不入庫）
reports/copy/*.copy.md
reports/copy/prompts/
reports/copy/responses/

# M7 儀表板產物（由 gen_dashboard.py 重建）
dashboard/index.html
# 台股版儀表板產物（由 gen_fund_dashboard.py --market tw 重建）
dashboard/tw.html

# OS
.DS_Store
